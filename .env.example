# =============================================================================
# NutriPod Environment Configuration Template (.env.example)
# Copy this file to .env and configure local values for development.
# NEVER commit .env to version control.
# =============================================================================

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=foodflow_db
BOOTSTRAP_POSTGRES_USER=postgres
BOOTSTRAP_POSTGRES_PASSWORD=ChangeMeBootstrapPostgresPassword!
POSTGRES_USER=foodflow_admin
POSTGRES_PASSWORD=ChangeMeLocalAdminPassword!

# Master Administrative Database Connection String (Used by Ingestion & Migrations)
DATABASE_URL=postgresql://foodflow_admin:ChangeMeLocalAdminPassword!@localhost:5432/foodflow_db

# Microservice Service Roles (Least-Privilege Connections)
PROFILE_SERVICE_DATABASE_URL=postgresql://foodflow_profile_user:ChangeMeProfilePassword!@localhost:5432/foodflow_db
RECIPE_SERVICE_DATABASE_URL=postgresql://foodflow_recipe_user:ChangeMeRecipePassword!@localhost:5432/foodflow_db
PLANNER_SERVICE_DATABASE_URL=postgresql://foodflow_planner_user:ChangeMePlannerPassword!@localhost:5432/foodflow_db

# Individual Role Passwords (Used for initial role provisioning & Compose variable interpolation)
FOODFLOW_ADMIN_PASSWORD=ChangeMeLocalAdminPassword!
FOODFLOW_PROFILE_PASSWORD=ChangeMeProfilePassword!
FOODFLOW_RECIPE_PASSWORD=ChangeMeRecipePassword!
FOODFLOW_PLANNER_PASSWORD=ChangeMePlannerPassword!

# Cross-Service Internal URLs (Docker network DNS resolution)
RECIPE_SERVICE_URL=http://recipe-service:8002
PROFILE_SERVICE_URL=http://profile-service:8001

# CORS Allowed Origins (Comma-separated browser origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ingestion Batch Parameters
FOODFLOW_BATCH_SIZE=1000

# Backend Microservice Port Allocations (Host mappings)
PORT_PROFILE_SERVICE=8001
PORT_RECIPE_SERVICE=8002
PORT_PLANNER_SERVICE=8003

# Frontend Application Port (Host mapping)
PORT_FRONTEND=5173
