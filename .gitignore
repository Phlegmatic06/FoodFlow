# FoodFlow Data Hygiene
# Keep raw, processed, and report outputs out of version control
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep

data/processed/**
!data/processed/
!data/processed/**/
!data/processed/**/.gitkeep

data/reports/**
!data/reports/
!data/reports/**/
!data/reports/**/.gitkeep

# Explicitly ensure dataset manifest is tracked
!data/manifest.json
